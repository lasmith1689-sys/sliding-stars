{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["vitest/globals", "node"],
    "skipLibCheck": true
  },
  "include": ["src", "tests", "scripts/campaign"]
}
