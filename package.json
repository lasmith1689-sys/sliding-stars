{
  "name": "sliding-stars",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {"node": ">=22.18.0"},
  "scripts": {
    "predev": "node scripts/prepare-art.mjs",
    "dev": "vite",
    "build": "node scripts/prepare-art.mjs && vite build && node scripts/offline.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:archive": "npm run ios:sync && bash .github/scripts/testflight.sh --archive-only",
    "ios:upload": "npm run ios:sync && bash .github/scripts/testflight.sh"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@types/node": "^26.1.0",
    "sharp": "^0.35.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/ios": "8.5.2",
    "@capacitor/preferences": "8.0.1",
    "pixi.js": "^8.19.0"
  }
}
